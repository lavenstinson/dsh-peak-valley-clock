{
  "name": "dsh-peak-valley-clock",
  "version": "1.0.0",
  "description": "DeepSeek Harness UI plugin: a centered white 24-hour clock above the conversation, with an avatar that switches between DeepSeek API peak and off-peak billing periods.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
